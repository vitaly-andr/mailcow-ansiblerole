# ACME Challenge and HTTPS Redirect Configuration
# Handles both Certbot (for monitoring services) and MailCow ACME (for mail domains)
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/html;

    # Security: Block malformed requests
    if ( $request_uri ~* "%0A|%0D" ) {
        return 403;
    }

    # ACME Challenge for Let's Encrypt
    # - First tries to serve file from /var/www/html (Certbot challenges)
    # - If file doesn't exist, proxies to MailCow ACME (for mail domains)
    location ^~ /.well-known/acme-challenge/ {
        allow all;
        default_type "text/plain";

{% if mailcow_enabled | default(false) %}
        # Try file first (Certbot), then proxy to MailCow if not found
        try_files $uri @mailcow_acme;
    }

    # Proxy to MailCow ACME for mail domains
    location @mailcow_acme {
        proxy_pass http://127.0.0.1:{{ mailcow__config_http_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% else %}
        # MailCow disabled, only serve Certbot challenges
        try_files $uri =404;
{% endif %}
    }

    # Redirect all other HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

