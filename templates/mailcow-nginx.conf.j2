# MailCow domain configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Note: ACME challenges for additional domains (autoconfig, autodiscover, etc.)
# are handled by mailcow-acme-default.conf (default server)

# Main MailCow domain - HTTP (redirect to HTTPS)
server {
    listen 80;
    server_name {{ mailcow_hostname }};

    # Proxy ACME challenge to MailCow for Let's Encrypt
    location ^~ /.well-known/acme-challenge/ {
        proxy_pass http://127.0.0.1:{{ mailcow__config_http_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Redirect all other HTTP to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

server {
    listen 443 ssl http2{% if nginx_proxy_protocol_enabled | default(false) %} proxy_protocol{% endif %};
    server_name {{ mailcow_hostname }};

    # SSL configuration - use MailCow certificates
    ssl_certificate {{ mailcow__install_path }}/data/assets/ssl/cert.pem;
    ssl_certificate_key {{ mailcow__install_path }}/data/assets/ssl/key.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:MozTLS:10m;
    ssl_session_tickets off;

    # Modern configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

{% if nginx_proxy_protocol_enabled | default(false) %}
    # PROXY Protocol - get real client IP from tunnel proxy
    set_real_ip_from 10.0.0.0/8;
    real_ip_header proxy_protocol;
{% endif %}

    # HSTS
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Proxy to MailCow
    location / {
        proxy_pass https://127.0.0.1:{{ mailcow__config_https_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
    }
}

# ========================================
# Autoconfig for Android/Thunderbird clients
# ========================================
server {
    listen 80;
    server_name autoconfig.{{ portal_domain }};

    # Proxy autoconfig requests directly to MailCow HTTPS (to avoid HTTP→HTTPS redirect)
    # Android/Thunderbird clients don't follow redirects for autoconfig
    # (ACME challenges handled by 00-acme-redirect default server)
    location / {
        proxy_pass https://127.0.0.1:{{ mailcow__config_https_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;  # Tell MailCow this was HTTP request
        proxy_ssl_verify off;
    }
}

